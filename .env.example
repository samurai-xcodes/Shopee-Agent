# Copy to .env. Local processes load it; existing environment variables take precedence.
DATABASE_URL=sqlite:///./data/agent.db
AUTH_MODE=dev
PROVIDER=mock
STORAGE_DIR=data/assets
CHECKPOINT_PATH=data/checkpoints.db
# Docker Compose requires a random URL-safe database password:
# POSTGRES_PASSWORD=
# Development only: supply X-Dev-User header, e.g. alice. Never expose dev mode publicly.
# Token mode: generate long random tokens yourself; do not commit them.
# AUTH_MODE=token
# API_TOKENS_JSON={"alice":"replace-with-a-random-secret-of-at-least-24-characters"}
# PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-api-gateway.example/v1
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-1
# 图片使用硅基流动时单独配置，不替换上方文本 API 密钥。
# IMAGE_PROVIDER=siliconflow
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_IMAGE_MODEL=Kwai-Kolors/Kolors
PROVIDER_TIMEOUT=60
MAX_ATTEMPTS=3
LEASE_SECONDS=600
QUEUE_LIMIT=100
REQUESTS_PER_MINUTE=20
TASKS_PER_DAY=100
